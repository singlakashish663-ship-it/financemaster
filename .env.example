# =============================================
# FinanceQuest Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/financequest

# --- Firebase Admin SDK (backend) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- JWT (fallback for non-Firebase auth) ---
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=7d

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Market Data Provider (optional) ---
# Leave blank to use built-in synthetic simulation mode
MARKET_DATA_PROVIDER=simulation
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# --- Payment Provider (optional) ---
# Leave blank to use development placeholder
PAYMENT_PROVIDER=placeholder
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Session Secret ---
SESSION_SECRET=change-this-to-another-long-random-secret

# --- Admin ---
ADMIN_EMAIL=admin@financequest.app

# =============================================
# Client (.env inside /client folder)
# =============================================
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_API_BASE_URL=http://localhost:5000/api/v1
